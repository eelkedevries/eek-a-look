# The host sends no Content-Type for these. Browsers refuse to import a module
# script without a JavaScript type, and cannot compile WebAssembly while it
# downloads without application/wasm.
AddType text/javascript .mjs
AddType application/wasm .wasm
AddType application/octet-stream .onnx

# The host does not compress WebAssembly, so the build ships a gzip copy
# (scripts/precompress.mjs) that the page requests directly. Serving it as
# gzip-encoded WebAssembly lets the browser decompress it transparently.
<FilesMatch "\.wasm\.gz$">
  ForceType application/wasm
  <IfModule mod_headers.c>
    Header set Content-Encoding gzip
  </IfModule>
  SetEnv no-gzip 1
</FilesMatch>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType application/wasm "access plus 30 days"
</IfModule>
